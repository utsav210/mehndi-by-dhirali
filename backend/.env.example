# ==============================================================================
# Mehndi By Dhirali — Backend Environment Variables (TEMPLATE ONLY)
# Copy this file to .env and fill with your own credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_DEBUG=true
APP_NAME="Mehndi By Dhirali API"

# Server Host & Port (for local uvicorn)
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://mehndi-by-dhirali.vercel.app

# Database Connection (Neon PostgreSQL serverless pooler connection string)
# Format: postgresql://[user]:[password]@[endpoint-pooler].neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./test.db

# JWT Security
JWT_SECRET_KEY=replace-with-a-64-character-random-hex-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Razorpay Payment Gateway (Test Mode for development)
# Get your test keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Supabase Storage (Free Tier - for product photography)
# Get credentials from your Supabase Project Settings -> API
SUPABASE_URL=https://placeholder-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key_for_backend_only
SUPABASE_STORAGE_BUCKET=mehndi-products

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_CHECKOUT="10/minute"
